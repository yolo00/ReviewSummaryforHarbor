+    line-height: 1.15;
+    color: var(--primary);
+}
+.eval-kpi-sub { font-size: 11px; color: var(--text-muted); }
+
+.eval-table th {
+    font-size: 12px;
+    font-weight: 700;
+    color: var(--primary);
+    background-color: var(--bg-page) !important;
+    border-bottom: 2px solid var(--accent) !important;
+}
+.eval-table td { font-size: 13px; }
+.eval-table tr.eval-avg td { font-weight: 700; background-color: rgba(227, 242, 253, .55); }
+.eval-dot {
+    display: inline-block;
+    width: 10px; height: 10px;
+    margin-right: 8px;
+    border-radius: 50%;
+}
+.eval-f1 { display: flex; align-items: center; justify-content: flex-end; gap: 10px; }
+.eval-bar {
+    width: 90px; height: 6px;
+    background: #E2E8F0;
+    border-radius: 999px;
+    overflow: hidden;
+}
+.eval-bar > span { display: block; height: 100%; border-radius: 999px; }
+.eval-note {
+    font-size: 12.5px;
+    color: var(--text-body);
+    background: rgba(13, 71, 161, .05);
+    border-left: 3px solid var(--primary);
+    border-radius: 8px;
+    padding: 10px 12px;
+}
+
+@media (max-width: 480px) {
+    .eval-kpi-value { font-size: 1.4rem; }
+    .eval-bar { width: 56px; }
+}
+
